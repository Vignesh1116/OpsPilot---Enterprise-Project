# Environment Variables Template for OpsPilot
# Copy this file to .env in backend/ or root

# Project Meta
PROJECT_NAME="OpsPilot"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API & Security
API_V1_PREFIX="/api/v1"
SECRET_KEY="opspilot-enterprise-super-secret-key-change-in-production-min32bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="opspilot_user"
POSTGRES_PASSWORD="opspilot_secure_password"
POSTGRES_DB="opspilot_db"
DATABASE_URL="postgresql+asyncpg://opspilot_user:opspilot_secure_password@localhost:5432/opspilot_db"
# Test DB URL fallback:
# TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Demonstration Enterprise Context
COMPANY_NAME="Coimbatore Industrial Textiles Ltd"
HQ_CITY="Coimbatore"
HQ_STATE="Tamil Nadu"
